="c4" target="c81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c83" value="Tour hướng dẫn lần đầu&lt;br&gt;(overlay trên Home/Editor/các tab)" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#C8C3D0;dashed=1;fontSize=11;fontColor=#5C5C5C;" vertex="1" parent="1"><mxGeometry x="2130" y="260" width="240" height="56" as="geometry"/></mxCell><mxCell id="c84" value="" style="fontFamily=Inter;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;html=1;endArrow=none;strokeColor=#A9A9A9;" edge="1" parent="1" source="c4" target="c83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c85" value="Chú giải: khung trắng = màn/route riêng · khung xám nét đứt = state, sheet, popover hoặc dialog của màn cha." style="fontFamily=Inter;shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="700" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5 · Task Hierarchy (HTA)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Hierarchical Task Analysis — mục tiêu 0: Ghi lại, sắp xếp và tìm lại thông tin" style="fontFamily=Inter;text;html=1;fontSize=26;fontStyle=1;fontColor=#222222;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Mỗi ô là một nhiệm vụ con; ô viền tím có phân rã tiếp. Plan (kế hoạch) ghi thứ tự thực hiện. Gạch dưới = thao tác dừng (không phân rã thêm)." style="fontFamily=Inter;text;html=1;fontSize=13;fontColor=#5C5C5C;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c4" value="0. Ghi lại, sắp xếp và tìm lại thông tin" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;fillColor=#7852EE;strokeColor=#7852EE;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1100" y="140" width="420" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Plan 0: làm 1 khi có thông tin mới; 2 khi cần sắp xếp; 3 khi cần dùng lại; 4 khi có hạn; 5 khi cần gửi người khác. Lần đầu: 0.0 xem tour (tuỳ chọn)." style="fontFamily=Inter;text;html=1;fontSize=11;fontStyle=2;fontColor=#9A6100;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1540" y="140" width="560" height="50" as="geometry"/></mxCell><mxCell id="c6" value="1. Ghi lại thông tin" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#EDE5FF;strokeColor=#7852EE;fontSize=12;fontStyle=1;fontColor=#43277B;" vertex="1" parent="1"><mxGeometry x="150" y="270" width="260" height="50" as="geometry"/></mxCell><mxCell id="c7" value="" style="fontFamily=Inter;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;html=1;endArrow=none;strokeColor=#A9A9A9;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="Plan 1: 1.1 → 1.2 → 1.3 lặp đến khi xong → 1.4 tự động; Back bất kỳ lúc nào." style="fontFamily=Inter;text;html=1;fontSize=11;fontStyle=2;fontColor=#9A6100;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="480" height="48" as="geometry"/></mxCell><mxCell id="c9" value="1.1 Chạm +" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#A9A9A9;fontSize=12;fontColor=#222222;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="200" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="fontFamily=Inter;edgeStyle=orthogon