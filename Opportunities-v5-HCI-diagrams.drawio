;rounded=0;html=1;endArrow=none;strokeColor=#C8C3D0;" edge="1" parent="1" source="c82" target="c87"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2230" y="472"/></Array></mxGeometry></mxCell><mxCell id="c89" value="5.3 Xác nhận link công khai" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#A9A9A9;fontSize=12;fontColor=#222222;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="2240" y="504" width="200" height="40" as="geometry"/></mxCell><mxCell id="c90" value="" style="fontFamily=Inter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#C8C3D0;" edge="1" parent="1" source="c82" target="c89"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2230" y="524"/></Array></mxGeometry></mxCell><mxCell id="c91" value="5.4 Gửi qua ứng dụng / QR" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#A9A9A9;fontSize=12;fontColor=#222222;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="2240" y="556" width="200" height="40" as="geometry"/></mxCell><mxCell id="c92" value="" style="fontFamily=Inter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#C8C3D0;" edge="1" parent="1" source="c82" target="c91"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2230" y="576"/></Array></mxGeometry></mxCell><mxCell id="c93" value="5.5 Thu hồi khi cần" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#A9A9A9;fontSize=12;fontColor=#222222;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="2240" y="608" width="200" height="40" as="geometry"/></mxCell><mxCell id="c94" value="" style="fontFamily=Inter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#C8C3D0;" edge="1" parent="1" source="c82" target="c93"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2230" y="628"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="6 · User Journey Map"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="User Journey Map — Trần Minh Thư (21, sinh viên CNTT năm 3 + gia sư, mức công nghệ trung bình)" style="fontFamily=Inter;text;html=1;fontSize=26;fontStyle=1;fontColor=#222222;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Mục tiêu: ghi bài trên lớp, quản lý việc dạy kèm (học phí, nhắc lịch), ôn thi nhanh. Bối cảnh: điện thoại, hay mất mạng, không biết Markdown. Đường cảm xúc so sánh trải nghiệm v5 (tím) với ứng dụng cũ (xám)." style="fontFamily=Inter;text;html=1;fontSize=13;fontColor=#5C5C5C;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c4" value="1. Bắt đầu dùng" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;fillColor=#7852EE;strokeColor=#7852EE;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="140" width="360" height="44" as="geometry"/></mxCell><mxCell id="c5" value="2. Ghi trong lớp" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;fillColor=#7852EE;strokeColor=#7852EE;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="360" height="44" as="geometry"/></mxCell><mxCell id="c6" value="3. Sắp xếp sau giờ học" style="fontFamily=Inter;rounded=1;whiteSpace=wrap;html=1;fillColor=#7852EE;strokeColor=#7852EE;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="140" width="360" height="44" as="geometry"/></mxCell><mxCell id="c7" value="4. Nhắc &amp; thu tiền" s