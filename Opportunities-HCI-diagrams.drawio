        </mxCell>
        <mxCell id="c24" value="Interaction styles used in Opportunities" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;text;fontStyle=1;fontSize=15;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1">
