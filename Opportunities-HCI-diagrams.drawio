        <mxCell id="c7" value="3 · Execution&lt;br&gt;Tap · tap · tap (3 taps, 44 pt targets, thumb zone)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;rounded=1;arcSize=18;fillColor=#E5F2FF;strokeColor=#0088FF;fontSize=12;" vertex="1" parent="1">
