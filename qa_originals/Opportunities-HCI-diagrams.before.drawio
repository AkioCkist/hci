          <mxGeometry x="610" y="100" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="1 · Intention&lt;br&gt;“Add a reminder to the fee item”" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;rounded=1;arcSize=18;fillColor=#E5F2FF;strokeColor=#0088FF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="230" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="2 · Action specification&lt;br&gt;Open note → tap bell next to ☐ “Thu học phí Minh” → pick “This Evening 18:00”" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;rounded=1;arcSize=18;fillColor=#E5F2FF;strokeColor=#0088FF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="370" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="3 · Execution&lt;br&gt;Tap · tap · tap (3 taps, 44 pt targets, thumb zone)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;rounded=1;arcSize=18;fillColor=#E5F2FF;strokeColor=#0088FF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="530" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="5 · Perception&lt;br&gt;Sees orange “Today 18:00” label + bell icon on the item; toast “Reminder set”" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;rounded=1;arcSize=18;fillColor=#E0F8FA;strokeColor=#00A8B5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="530" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="6 · Interpretation&lt;br&gt;“The reminder is attached to this exact task”" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;rounded=1;arcSize=18;fillColor=#E0F8FA;strokeColor=#00A8B5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="970" y="370" width="260" height="70" as="geometry" />
