        <mxCell id="c20" value="GULF OF EXECUTION" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;text;fontStyle=1;fontColor=#0088FF;fontSize=14;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="Design bridges:&lt;br&gt;• Bell button sits right next to the checklist item (mapping)&lt;br&gt;• Quick picks: This Evening / Tomorrow / Before Next Class (recognition over recall)&lt;br&gt;• Same pattern everywhere — Apple sheet &amp; toggles (consistency)&lt;br&gt;• Large targets, one-hand reach (Fitts’s law)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;text;align=left;verticalAlign=top;fontSize=11;rounded=1;strokeColor=#0088FF;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="200" height="260" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="GULF OF EVALUATION" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;text;fontStyle=1;fontColor=#00A8B5;fontSize=14;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1280" y="330" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="Design bridges:&lt;br&gt;• Immediate feedback: toast + orange due label (complementary accent)&lt;br&gt;• System status always visible: “Saved · Synced” badge&lt;br&gt;• Result visible in a second place (Tasks › Today)&lt;br&gt;• Undo available — errors are reversible" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;text;align=left;verticalAlign=top;fontSize=11;rounded=1;strokeColor=#00A8B5;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="1">
