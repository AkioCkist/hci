        <mxCell id="c3" value="Task: “Remind me to collect Minh’s tuition fee tonight” (persona Thư). Shows how the UI bridges the Gulf of Execution and the Gulf of Evaluation." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;text;fontSize=13;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#6E6E73;" vertex="1" parent="1">
