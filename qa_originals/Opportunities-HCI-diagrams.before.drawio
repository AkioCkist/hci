        </mxCell>
        <mxCell id="c25" value="Direct manipulation&lt;br&gt;drag scan corners, tick checkboxes, swipe to delete" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;rounded=1;arcSize=18;fillColor=#E5F2FF;strokeColor=#0088FF;fontSize=12;" vertex="1" parent="1">
