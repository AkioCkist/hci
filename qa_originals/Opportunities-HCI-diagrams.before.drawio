        <mxCell id="c10" value="7 · Evaluation&lt;br&gt;Goal met? Item also appears in Tasks › Today ✓" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;rounded=1;arcSize=18;fillColor=#E0F8FA;strokeColor=#00A8B5;fontSize=12;" vertex="1" parent="1">
