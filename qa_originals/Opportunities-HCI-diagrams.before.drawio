        <mxCell id="c2" value="Interaction Diagram — Norman’s 7 stages of action applied to a real task" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1C1C1E;text;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
